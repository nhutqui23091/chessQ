{
  "name": "chess-move-percent",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension showing opening move percentages on Chess.com",
  "scripts": {
    "test": "node --test test/*.test.js",
    "icons": "node tools/make-icons.js",
    "bundle:chess": "esbuild tools/chess-entry.js --bundle --format=iife --global-name=ChessLib --minify --legal-comments=none --target=chrome100 --outfile=src/vendor/chess.bundle.js",
    "zip": "node tools/package.js"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  }
}
